{
  "info": {
    "name": "KhazObras API",
    "description": "Coleção completa da API KhazObras — 48 endpoints\n\nStack: .NET 10 | PostgreSQL 16 | Cloudflare R2\n\nVer: API.md para documentação completa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Autenticação e obtenção de token JWT",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\n    pm.environment.set('jwt_token', pm.response.json().token);\n    console.log('Token salvo: ' + pm.response.json().token.substring(0, 20) + '...');\n}"
                ]
              }
            }
          ]
        }
      ]
    },
