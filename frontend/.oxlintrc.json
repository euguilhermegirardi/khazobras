// Lint do frontend KhazObras (oxlint). Cada regra tem o porquê ao lado.
// Rodar: npm run lint. Mudou uma regra? Registrar em docs/PLAN-09-frontend.md (Decisões).
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "import"],
  "rules": {
    // --- React ---
    "react/rules-of-hooks": "error", // hooks sempre na mesma ordem (nada de hook depois de return/if)
    "react/exhaustive-deps": "warn", // dependências corretas no useEffect/useMemo/useCallback
    "react/only-export-components": ["warn", { "allowConstantExport": true }], // fast refresh do Vite

    // --- Segurança (frontend/CLAUDE.md, seção Segurança) ---
    "react/no-danger": "error", // proíbe dangerouslySetInnerHTML (XSS)
    "no-restricted-globals": [
      "error",
      { "name": "localStorage", "message": "Token/sessão só em sessionStorage (services/session.ts)." }
    ],

    // --- TypeScript ---
    "typescript/no-explicit-any": "error", // use unknown + validação, nunca any
    "typescript/consistent-type-imports": "error", // `import type` para tipos/interfaces

    // --- Qualidade ---
    "eqeqeq": "error", // sempre === / !==
    "no-console": "warn", // nada de console.log esquecido (nunca logar token)

    // --- Acessibilidade ---
    "jsx-a11y/alt-text": "error", // toda imagem com alt
    "jsx-a11y/label-has-associated-control": "error", // todo input com label
    "jsx-a11y/prefer-tag-over-role": "off" // <div role="status"> é o padrão ARIA para carregando; <output> não serve aqui
  },
  "overrides": [
    {
      // Componentes e telas: tudo como const + arrow function (componente, handlers, helpers internos).
      "files": [
        "src/modules/**/*.tsx",
        "src/components/*.tsx",
        "src/layouts/**/*.tsx",
        "src/routes/**/*.tsx",
        "src/providers.tsx"
      ],
      "rules": { "func-style": ["error", "expression"] }
    },
    {
      // Funções utilitárias e serviços puros: `function` nomeada.
      "files": ["src/utils/**/*.ts", "src/services/**/*.ts"],
      "rules": { "func-style": ["error", "declaration", { "allowArrowFunctions": false }] }
    },
    {
      // Um módulo nunca importa de outro; o comum vive na raiz de src/ (components, utils, interfaces...).
      // Arquivos do próprio módulo: import relativo.
      "files": ["src/modules/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/modules/*", "@/modules/**"],
                "message": "Módulo não importa de outro módulo: suba o código para src/components, src/utils, src/interfaces..."
              },
              {
                "group": ["@/routes/*", "@/routes/**", "@/layouts/*", "@/layouts/**"],
                "message": "modules não dependem de routes/ nem de layouts/ (direção: routes → layouts/modules → base)."
              }
            ]
          }
        ]
      }
    },
    {
      // Moldura (sidebar/topbar): não conhece telas nem rotas.
      "files": ["src/layouts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/modules/*", "@/modules/**", "@/routes/*", "@/routes/**"],
                "message": "layouts/ não importa de modules/ nem de routes/."
              }
            ]
          }
        ]
      }
    },
    {
      // Base (components, interfaces, utils, services, auth, hooks): não conhece módulos, rotas nem layouts.
      "files": [
        "src/components/**",
        "src/interfaces/**",
        "src/utils/**",
        "src/services/**",
        "src/auth/**",
        "src/hooks/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/modules/*", "@/modules/**", "@/routes/*", "@/routes/**", "@/layouts/*", "@/layouts/**"],
                "message": "A base de src/ não importa de modules/, routes/ nem layouts/."
              }
            ]
          }
        ]
      }
    },
    {
      // Testes: helpers podem ser function; console liberado para depuração local.
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
      "rules": { "func-style": "off", "no-restricted-imports": "off", "no-console": "off" }
    }
  ]
}
